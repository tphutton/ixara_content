generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  editor
  viewer
}

enum ApprovalStatus {
  pending
  approved
  rejected
}

enum ContentStatus {
  idea
  draft
  approved
  scheduled
  published
  archived
}

enum ContentType {
  social_post
  caption
  ad_copy
  newsletter
  video_script
  campaign_copy
  promo_copy
}

enum BlogStatus {
  idea
  draft
  review
  approved
  published
  archived
}

enum ScheduleStatus {
  planned
  ready
  scheduled
  published
  missed
  cancelled
}

enum ChatRole {
  user
  assistant
  tool
  system
}

enum AssetSource {
  wordpress
  manual
}

enum AutomationType {
  weekly_social_content
  blog_post_generation
}

enum AutomationStatus {
  draft
  active
  paused
  archived
}

enum AutomationFrequency {
  manual
  weekly
}

enum AutomationRunStatus {
  running
  succeeded
  failed
}

enum SocialPlatform {
  facebook
  instagram
  linkedin
  x
  tiktok
  youtube
  manual_import
}

enum ConnectedAccountStatus {
  pending_setup
  active
  needs_reauth
  disconnected
  error
}

enum PublishedPostStatus {
  draft
  published
  failed
  deleted
  imported
}

enum ContentPlanStatus {
  draft
  review
  approved
  active
  completed
  archived
}

enum ContentPlanItemType {
  content
  blog
  schedule
  asset_request
  automation
}

enum ContentPlanItemStatus {
  planned
  approved
  created
  scheduled
  published
  blocked
  cancelled
}

model UserAccess {
  id             String           @id @default(cuid())
  clerkUserId    String           @unique
  email          String           @unique
  fullName       String?
  role           UserRole         @default(viewer)
  approvalStatus ApprovalStatus   @default(pending)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  contentCreated     Content[]          @relation("ContentCreatedBy")
  contentUpdated     Content[]          @relation("ContentUpdatedBy")
  blogsCreated       Blog[]             @relation("BlogCreatedBy")
  blogsUpdated       Blog[]             @relation("BlogUpdatedBy")
  assetsCreated      Asset[]            @relation("AssetCreatedBy")
  assetsUpdated      Asset[]            @relation("AssetUpdatedBy")
  schedulesCreated   ContentSchedule[]  @relation("ScheduleCreatedBy")
  schedulesApproved  ContentSchedule[]  @relation("ScheduleApprovedBy")
  automationsCreated AutomationWorkflow[] @relation("AutomationCreatedBy")
  automationsUpdated AutomationWorkflow[] @relation("AutomationUpdatedBy")
  automationRuns     AutomationRun[]    @relation("AutomationTriggeredBy")
  connectedAccountsCreated ConnectedAccount[] @relation("ConnectedAccountCreatedBy")
  connectedAccountsUpdated ConnectedAccount[] @relation("ConnectedAccountUpdatedBy")
  publishedPostsCreated    PublishedPost[]    @relation("PublishedPostCreatedBy")
  publishedPostsUpdated    PublishedPost[]    @relation("PublishedPostUpdatedBy")
  contentPlansCreated      ContentPlan[]       @relation("ContentPlanCreatedBy")
  contentPlansUpdated      ContentPlan[]       @relation("ContentPlanUpdatedBy")
  chatThreads        ChatThread[]
  actionLogs         ContentActionLog[]

  @@index([approvalStatus, role])
}

model Content {
  id             String        @id @default(cuid())
  title          String
  body           String?
  hook           String?
  cta            String?
  contentType    ContentType
  platform       String?
  status         ContentStatus @default(idea)
  campaignName   String?
  brand          String?
  sport          String?
  region         String?
  country        String?
  tags           String[]
  targetAudience String?
  tone           String?
  websites       String[]
  assetImage     String?
  assetCaption   String?
  primaryAssetId String?
  aiGenerated    Boolean       @default(false)
  sourcePrompt   String?
  createdById    String?
  updatedById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  createdBy UserAccess?        @relation("ContentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy UserAccess?        @relation("ContentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  primaryAsset Asset?          @relation("ContentPrimaryAsset", fields: [primaryAssetId], references: [id], onDelete: SetNull)
  assets     ContentAsset[]
  schedules ContentSchedule[]
  publishedPosts PublishedPost[]
  planItems ContentPlanItem[]

  @@index([status, contentType])
  @@index([brand, sport, region, country])
}

model Blog {
  id             String      @id @default(cuid())
  legacyExternalId Int?      @unique
  legacyBlogId    String?    @unique
  legacyZohoId    String?
  title          String
  brand          String?
  postDate       DateTime?
  authorName     String?
  authorImage    String?
  featureImage   String?
  featureAssetId String?
  text1          String?
  image1         String?
  image1Caption  String?
  text2          String?
  image2         String?
  image2Caption  String?
  text3          String?
  image3         String?
  image3Caption  String?
  text4          String?
  image4         String?
  image4Caption  String?
  text5          String?
  image5         String?
  image5Caption  String?
  text6          String?
  image6         String?
  image6Caption  String?
  text7          String?
  image7         String?
  image7Caption  String?
  text8          String?
  image8         String?
  image8Caption  String?
  websites       String[]
  category       String?
  tags           String[]
  authorBio      String?
  status         BlogStatus   @default(idea)
  sport          String?
  region         String?
  country        String?
  sources        String[]
  createdById    String?
  updatedById    String?
  aiGenerated    Boolean      @default(false)
  sourcePrompt   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  createdBy UserAccess?       @relation("BlogCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy UserAccess?       @relation("BlogUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  featureAsset Asset?         @relation("BlogFeatureAsset", fields: [featureAssetId], references: [id], onDelete: SetNull)
  assets      BlogAsset[]
  schedules ContentSchedule[]
  publishedPosts PublishedPost[]
  planItems ContentPlanItem[]

  @@index([status, postDate])
  @@index([brand, category, sport, region, country])
  @@index([legacyZohoId])
}

model ContentSchedule {
  id              String         @id @default(cuid())
  contentId       String?
  blogId          String?
  scheduledFor    DateTime
  channel         String?
  platformAccount String?
  status          ScheduleStatus @default(planned)
  campaignName    String?
  priority        String?
  notes           String?
  brand           String?
  sport           String?
  region          String?
  country         String?
  approvedById    String?
  createdById     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  content    Content?    @relation(fields: [contentId], references: [id], onDelete: SetNull)
  blog       Blog?       @relation(fields: [blogId], references: [id], onDelete: SetNull)
  approvedBy UserAccess? @relation("ScheduleApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  createdBy  UserAccess? @relation("ScheduleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  publishedPosts PublishedPost[]
  planItems ContentPlanItem[]

  @@index([scheduledFor, status])
  @@index([brand, sport, region, country])
}

model ContentPlan {
  id           String            @id @default(cuid())
  title        String
  description  String?
  goal         String?
  status       ContentPlanStatus @default(draft)
  startDate    DateTime?
  endDate      DateTime?
  brand        String?
  campaignName String?
  sourcePrompt String?
  createdById  String?
  updatedById  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  createdBy UserAccess?       @relation("ContentPlanCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy UserAccess?       @relation("ContentPlanUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  items     ContentPlanItem[]

  @@index([status, startDate])
  @@index([brand, campaignName])
}

model ContentPlanItem {
  id           String                @id @default(cuid())
  planId       String
  itemType     ContentPlanItemType
  status       ContentPlanItemStatus @default(planned)
  title        String
  brief        String?
  channel      String?
  scheduledFor DateTime?
  brand        String?
  sport        String?
  region       String?
  country      String?
  campaignName String?
  contentId    String?
  blogId       String?
  scheduleId   String?
  assetRequest String?
  sortOrder    Int                   @default(0)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  plan     ContentPlan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  content  Content?         @relation(fields: [contentId], references: [id], onDelete: SetNull)
  blog     Blog?            @relation(fields: [blogId], references: [id], onDelete: SetNull)
  schedule ContentSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  @@index([planId, sortOrder])
  @@index([status, scheduledFor])
  @@index([contentId])
  @@index([blogId])
  @@index([scheduleId])
}

model ChatThread {
  id          String        @id @default(cuid())
  userId      String
  title       String
  contextType String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user     UserAccess    @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId, updatedAt])
}

model ChatMessage {
  id          String    @id @default(cuid())
  threadId    String
  role        ChatRole
  content     String
  toolName    String?
  toolPayload Json?
  createdAt   DateTime  @default(now())

  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

model ContentActionLog {
  id         String   @id @default(cuid())
  userId     String
  actionType String
  targetType String
  targetId   String
  summary    String
  beforeData Json?
  afterData  Json?
  source     String
  createdAt  DateTime @default(now())

  user UserAccess @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([targetType, targetId])
}

model BrandProfile {
  id                String   @id @default(cuid())
  brandName         String   @unique
  description       String?
  positioning       String?
  defaultTone       String?
  targetAudience    String?
  preferredWebsites String[]
  sports            String[]
  regions           String[]
  countries         String[]
  contentPillars    String[] @default([])
  audiencePersonas  String[] @default([])
  keyOffers         String[] @default([])
  proofPoints       String[] @default([])
  seoKeywords       String[] @default([])
  competitors       String[] @default([])
  voiceExamples     String[] @default([])
  visualGuidelines  String?
  instagramGuidelines String?
  facebookGuidelines  String?
  linkedinGuidelines  String?
  blogGuidelines      String?
  emailGuidelines     String?
  adGuidelines        String?
  bannedPhrases     String[]
  preferredCTAs     String[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  automationWorkflows AutomationWorkflow[]
  connectedAccounts   ConnectedAccount[]
}

model Asset {
  id               String       @id @default(cuid())
  source           AssetSource
  externalId       String?
  title            String
  slug             String?
  fileUrl          String       @unique
  thumbnailUrl     String?
  mimeType         String?
  mediaType        String?
  width            Int?
  height           Int?
  fileSize         Int?
  altText          String?
  caption          String?
  sourceCreatedAt  DateTime?
  sourceUpdatedAt  DateTime?
  metadata         Json?
  tags             String[]
  brand            String?
  campaignName     String?
  sport            String?
  region           String?
  country          String?
  createdById      String?
  updatedById      String?
  syncedAt         DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  createdBy            UserAccess?       @relation("AssetCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy            UserAccess?       @relation("AssetUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  contentPrimaryFor    Content[]         @relation("ContentPrimaryAsset")
  blogFeatureFor       Blog[]            @relation("BlogFeatureAsset")
  contentLinks         ContentAsset[]
  blogLinks            BlogAsset[]
  campaignLinks        CampaignAsset[]

  @@unique([source, externalId])
  @@index([source, syncedAt])
  @@index([brand, campaignName, sport, region, country])
}

model ContentAsset {
  id         String   @id @default(cuid())
  contentId  String
  assetId    String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  asset   Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([contentId, assetId])
  @@index([assetId])
}

model BlogAsset {
  id         String   @id @default(cuid())
  blogId     String
  assetId    String
  slot       String
  createdAt  DateTime @default(now())

  blog  Blog  @relation(fields: [blogId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([blogId, slot])
  @@index([assetId])
}

model CampaignAsset {
  id          String   @id @default(cuid())
  campaignId  String
  assetId     String
  role        String?
  createdAt   DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([campaignId, assetId])
  @@index([campaignId])
}

model AutomationWorkflow {
  id                  String              @id @default(cuid())
  name                String
  type                AutomationType
  status              AutomationStatus    @default(draft)
  frequency           AutomationFrequency @default(weekly)
  description         String?
  promptTemplate      String?
  brandProfileId      String?
  brandName           String?
  targetContentStatus ContentStatus       @default(draft)
  itemCount           Int                 @default(5)
  dayOfWeek           Int?
  runTime             String?
  timezone            String?
  channels            String[]
  platforms           String[]
  region              String?
  country             String?
  sport               String?
  lastRunAt           DateTime?
  nextRunAt           DateTime?
  createdById         String?
  updatedById         String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  brandProfile BrandProfile? @relation(fields: [brandProfileId], references: [id], onDelete: SetNull)
  createdBy    UserAccess?   @relation("AutomationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    UserAccess?   @relation("AutomationUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  runs         AutomationRun[]

  @@index([status, nextRunAt])
  @@index([brandName, type])
}

model AutomationRun {
  id            String              @id @default(cuid())
  workflowId    String
  status        AutomationRunStatus
  summary       String?
  output        Json?
  errorMessage  String?
  startedAt     DateTime            @default(now())
  completedAt   DateTime?
  triggeredById String?
  createdAt     DateTime            @default(now())

  workflow    AutomationWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  triggeredBy UserAccess?        @relation("AutomationTriggeredBy", fields: [triggeredById], references: [id], onDelete: SetNull)

  @@index([workflowId, startedAt])
  @@index([status, startedAt])
}

model ConnectedAccount {
  id                    String               @id @default(cuid())
  platform              SocialPlatform
  status                ConnectedAccountStatus @default(pending_setup)
  accountName           String
  accountHandle         String?
  externalAccountId     String?
  brandProfileId        String?
  brandName             String?
  region                String?
  country               String?
  scopes                String[]
  encryptedAccessToken  String?
  encryptedRefreshToken String?
  tokenExpiresAt        DateTime?
  lastSyncedAt          DateTime?
  lastSyncStatus        String?
  metadata              Json?
  createdById           String?
  updatedById           String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  brandProfile BrandProfile? @relation(fields: [brandProfileId], references: [id], onDelete: SetNull)
  createdBy    UserAccess?   @relation("ConnectedAccountCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    UserAccess?   @relation("ConnectedAccountUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  publishedPosts PublishedPost[]

  @@unique([platform, externalAccountId])
  @@index([status, platform])
  @@index([brandName, region, country])
}

model PublishedPost {
  id                    String              @id @default(cuid())
  connectedAccountId    String?
  contentId             String?
  blogId                String?
  scheduleId            String?
  platform              SocialPlatform
  platformAccountName   String?
  externalPostId        String?
  externalPostUrl       String?
  titleSnapshot         String?
  captionSnapshot       String?
  mediaSnapshot         Json?
  status                PublishedPostStatus @default(imported)
  publishedAt           DateTime?
  importedAt            DateTime?
  latestAnalyticsAt     DateTime?
  createdById           String?
  updatedById           String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  connectedAccount ConnectedAccount?      @relation(fields: [connectedAccountId], references: [id], onDelete: SetNull)
  content          Content?               @relation(fields: [contentId], references: [id], onDelete: SetNull)
  blog             Blog?                  @relation(fields: [blogId], references: [id], onDelete: SetNull)
  schedule         ContentSchedule?       @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  createdBy        UserAccess?            @relation("PublishedPostCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy        UserAccess?            @relation("PublishedPostUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  analyticsSnapshots PostAnalyticsSnapshot[]

  @@unique([platform, externalPostId])
  @@index([connectedAccountId, publishedAt])
  @@index([contentId, blogId, scheduleId])
  @@index([status, platform, publishedAt])
}

model PostAnalyticsSnapshot {
  id               String        @id @default(cuid())
  publishedPostId  String
  capturedAt       DateTime      @default(now())
  impressions      Int?
  reach            Int?
  engagements      Int?
  likes            Int?
  comments         Int?
  shares           Int?
  saves            Int?
  clicks           Int?
  videoViews       Int?
  engagementRate   Float?
  clickThroughRate Float?
  metadata         Json?
  createdAt        DateTime      @default(now())

  publishedPost PublishedPost @relation(fields: [publishedPostId], references: [id], onDelete: Cascade)

  @@index([publishedPostId, capturedAt])
  @@index([capturedAt])
}
