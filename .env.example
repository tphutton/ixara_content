# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Content Ops AI

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_SIGN_IN_URL=/sign-in
CLERK_SIGN_UP_URL=/sign-up

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/content_ops_ai?schema=public

# OpenAI
OPENAI_API_KEY=sk-your_openai_api_key
OPENAI_MODEL=gpt-5-mini

# TechSport Campaigns API
CAMPAIGNS_API_BASE_URL=https://data.techsport.asia/api
CAMPAIGNS_API_KEY=your_campaigns_api_key

# WordPress media sync
WORDPRESS_MEDIA_BASE_URL=https://media.ixara.tech/wp-json/wp/v2

# Seed / bootstrap
INITIAL_ADMIN_EMAIL=admin@example.com
